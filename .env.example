# Server-side Gemini integration is optional.
# Leave unset to use the explicitly labeled local simulation/fallback planner.
GEMINI_API_KEY=""
# Required together with GEMINI_API_KEY for a live Gemini provider call.
# Set this to a model currently available to your Gemini account.
GEMINI_MODEL=""

# Public application URL used for links/callbacks where needed.
APP_URL="http://localhost:3000"

# Hosting platforms may override PORT.
PORT="3000"
